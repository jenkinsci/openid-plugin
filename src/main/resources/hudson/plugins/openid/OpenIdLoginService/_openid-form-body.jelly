<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <div id="openid_form_config"
       data-openid-assets="${resURL}/openid-assets/"
       data-openid-signin-text="${%Login}">
    <link type="text/css" rel="stylesheet" href="${resURL}/openid-assets/openid.css"/>
    <script type="text/javascript" src="${resURL}/openid-assets/openid-prototype.js"/>

    <div id="openid_input_area">
      <input id="openid" name="openid_identifier" type="text" class="jenkins-input" value="https://"/>
      <f:submit value="${%Login!}"/>
    </div>
  </div>
</j:jelly>
